# Create a PRIVATE Vercel Blob store and connect it to the Vercel project.
# Use the same token in the GitHub repository's BLOB_READ_WRITE_TOKEN Actions secret.
BLOB_READ_WRITE_TOKEN=
# Local development only: without a Blob token, collector and API share this cache.
DATA_CACHE_DIR=.cache
APPLE_BACKGROUND_GAP_MS=8000
