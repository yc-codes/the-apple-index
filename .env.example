# Collector checkpoints (restored through GitHub Actions cache).
DATA_CACHE_DIR=.cache
# Published snapshots. Builds bundle ./data; copy here if using another collector directory.
DATA_PUBLISH_DIR=data
# Delay between Apple requests, in milliseconds.
APPLE_BACKGROUND_GAP_MS=8000
# Use existing local snapshots instead of fetching the public data branch.
# DATA_SOURCE=local
